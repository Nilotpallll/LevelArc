# ============================================================
# Copy this file to .env (local dev) and set the same keys in
# Vercel → Project → Settings → Environment Variables (prod)
# ============================================================

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — SERVER-SIDE ONLY. Never expose in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe (Developers → API keys) ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# Create these as recurring Prices in Stripe Dashboard → Product catalog
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxx
STRIPE_PRICE_PLACEMENT_READY=price_xxxxxxxxxxxx

# --- GitHub (optional, raises rate limits + enables contribution counts) ---
# Create at github.com/settings/tokens → classic token → no scopes needed for public data
GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# --- Site URL (used for Stripe redirect + CORS) ---
SITE_URL=https://your-domain.vercel.app
